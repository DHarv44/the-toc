  "_staff_doc": "The Federation is a bureaucracy that wears a uniform — the satire is that the paperwork drops with you. The desks keep the same numbering at every rung and only change letter: S at a company, R at a regiment, G at a division.",
  "staff": {
    "s1": {
      "label": "S1", "name": "Personnel", "full": "S1 — Personnel", "report": "MUSTER",
      "alt": "S1 Sergeant", "desks": ["S1", "R1", "G1"],
      "desc": "Strength, casualties, replacements",
      "detail": "The S1 keeps the muster: who dropped, who came back, who is on the retrieval board and who is not coming back at all. Federal Service is a contract with names on it, and this desk holds the names."
    },
    "s2": {
      "label": "S2", "name": "Intelligence", "full": "S2 — Intelligence", "report": "BUGSTAT",
      "alt": "S2 Analyst", "desks": ["S2", "R2", "G2"],
      "desc": "Hostile strength, holes, warrior counts",
      "detail": "The S2 reads the ground for holes and counts what comes out of them. The Federal Network says the enemy is mindless; the S2 files what it actually sees."
    },
    "s3": {
      "label": "S3", "name": "Operations", "full": "S3 — Operations", "report": "DROPSTAT",
      "alt": "Operations Sergeant", "desks": ["S3", "R3", "G3"],
      "desc": "Drop plan, scheme of manoeuvre, retrieval",
      "detail": "The S3 writes the drop: the pattern, the bounce, the objective and the retrieval window. On the ground it runs the fight and counts the minutes to pickup."
    },
    "s4": {
      "label": "S4", "name": "Logistics", "full": "S4 — Logistics", "report": "AMMOSTAT",
      "alt": "S4 Sergeant", "desks": ["S4", "R4", "G4"],
      "desc": "Suit power, rounds, rockets, nuclears",
      "detail": "The S4 accounts for what a suit carries and what it has left. Nothing resupplies on the ground: what dropped is what there is, which makes this desk a clock as much as a ledger."
    },
    "s6": {
      "label": "S6", "name": "Signal", "full": "S6 — Signal", "report": "NETSTAT",
      "desks": ["S6", "R6", "G6"],
      "desc": "Suit net, relay, orbital link",
      "detail": "The S6 owns the suit net and the link to the boat overhead. Losing the link does not lose the fight; it loses the retrieval, which is worse."
    }
  },

