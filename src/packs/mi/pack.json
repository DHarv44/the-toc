  "_mottos_doc": "A named company keeps its name after the man it is named for is dead. That is the one piece of Mobile Infantry sentiment the Federation permits.",
  "mottos": {
    "G/3": "We are the Roughnecks",
    "K/3": "Come on you apes"
  },
  "nicks": {
    "G/3": "ROUGHNECKS",
    "K/3": "WILDCATS"
  },

