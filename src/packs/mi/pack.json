          { "desig": "B/1", "nick": "Baker", "kind": "MI-RIFLE-CO" },
          { "desig": "C/1", "nick": "Charlie", "kind": "MI-RIFLE-CO" }
        ]
      },
      {
        "desig": "2 MI", "nick": "Hard Rain", "kind": "MI-REGT-HQ", "station": "TRANSPORT TOURS",
