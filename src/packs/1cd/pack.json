{
  "_doc": "1st Cavalry Division — the player's pack. Self-contained folder: this manifest + names.json (+ crests/audio under public/ until the runtime loader serves pack folders directly). `catalogs.extends` pulls the shared US platform library; a total-conversion pack would inline its own tables instead.",
  "id": "1cd",
  "name": "1st Cavalry Division",
  "abbr": "1CD",
  "nick": "First Team",
  "motto": "First Team",
  "patch": "1cd",
  "_startForce_doc": "What is already on the ground beside the CP when a battle opens, in fielding order — scouts out first, then the line, then armour and the log package. The DIFFICULTY decides how many of these get fielded, so the tiers are prefixes of this one list.",
  "startForce": ["SCT", "INF", "INF", "MECH", "ARM", "LOG"],
  "catalogs": {
    "extends": "us-platforms"
  },
  "campaigns": [
    "iron-triangle"
  ],
  "audio": {
    "incomingAlarm": "/audio/incoming.mp3"
  },
  "staff": {
    "s1": {
      "label": "S1",
      "name": "Personnel",
      "full": "S1 — Personnel",
      "report": "PERSTAT",
      "alt": "S1 NCOIC",
      "desks": ["S1", "G1"],
      "desc": "Strength, casualties, replacements",
      "detail": "The S1 shop tracks every soldier in the task force: assigned strength, wounded and killed, the DUSTWUN board, the replacement pipeline from rear detachment, promotions and awards. Its PERSTAT is the commander's honest picture of the people."
    },
    "s2": {
      "label": "S2",
      "name": "Intelligence",
      "full": "S2 — Intelligence",
      "report": "INTSUM",
      "alt": "S2 Analyst",
      "desks": ["S2", "G2"],
      "desc": "Enemy picture, tracks, collection",
      "detail": "The S2 shop owns the enemy picture as the COP actually knows it: live tracks, stale last-knowns, assessed-but-unidentified contacts, and the collection plan that feeds them. What the sensors cannot see, the S2 will not claim."
    },
    "s3": {
      "label": "S3",
      "name": "Operations",
      "full": "S3 — Operations",
      "report": "OPSUM",
      "alt": "Operations NCO",
      "desks": ["S3", "G3"],
      "desc": "Objectives, orders, the fight",
      "detail": "The S3 shop runs the current fight: the operation's objectives, orders received, task organization, unit states and ROE, and open incidents like personnel recovery. The OPSUM is the fight as it stands, no varnish."
    },
    "s4": {
      "label": "S4",
      "name": "Logistics",
      "full": "S4 — Logistics",
      "report": "LOGSTAT",
      "alt": "S4 NCOIC",
      "desks": ["S4", "G4"],
      "desc": "Motorpool, munitions, division assets",
      "detail": "The S4 shop keeps the iron running: vehicle operational-readiness and the motorpool queue, Class V posture across the tubes, forward stock at the FOBs, convoys on the road, and the division asset board — what is allocated, inbound, or on the waiting list."
    },
    "s6": {
      "label": "S6",
      "name": "Signal",
      "full": "S6 — Signal",
      "report": "COMSTAT",
      "desks": ["S6", "G6"],
      "desc": "Net status, retrans, comms coverage",
      "detail": "The S6 shop owns the network: retrans coverage, net health and (when the systems exist) jamming and electronic protection. Stands up with the EW layer."
    }
  },
