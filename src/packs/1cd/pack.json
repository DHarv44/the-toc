    },
    "BSM_V": {
      "key": "BSM_V", "name": "Bronze Star Medal w/ Valor", "abbr": "BSM-V",
      "ribbon": ["#7a1f1f", "#ffffff", "#274060", "#ffffff", "#7a1f1f"]
    }
  },
